{
  "name": "loom-session-tracker",
  "displayName": "Loom Session Tracker",
  "description": "Live per-project map of Loom session agents (role \u2194 webviewId) over CDP. Shows the orchestrator session so you can tag it in one click; tagged, it is auto-notified whenever a worker finishes.",
  "version": "0.7.2",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "loomSessionTracker",
          "title": "Loom Sessions",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "loomSessionTracker": [
        {
          "id": "loomSessions",
          "name": "Session Agents"
        }
      ]
    },
    "commands": [
      {
        "command": "loomSessionTracker.refresh",
        "title": "Loom Sessions: Refresh Now",
        "icon": "$(sync)"
      },
      {
        "command": "loomSessionTracker.status",
        "title": "Loom Sessions: Show Status"
      },
      {
        "command": "loomSessionTracker.spawn",
        "title": "Loom Sessions: Spawn Session\u2026",
        "icon": "$(add)"
      },
      {
        "command": "loomSessionTracker.retire",
        "title": "Loom Sessions: Retire (Close) Session",
        "icon": "$(close)"
      },
      {
        "command": "loomSessionTracker.delete",
        "title": "Loom Sessions: Delete Session (worktree + transcript)",
        "icon": "$(trash)"
      },
      {
        "command": "loomSessionTracker.lock",
        "title": "Loom Sessions: Lock (protect from deletion)",
        "icon": "$(lock)"
      },
      {
        "command": "loomSessionTracker.unlock",
        "title": "Loom Sessions: Unlock",
        "icon": "$(unlock)"
      },
      {
        "command": "loomSessionTracker.tagOrchestrator",
        "title": "Loom Sessions: Tag as Orchestrator",
        "icon": "$(star-full)"
      },
      {
        "command": "loomSessionTracker.untagOrchestrator",
        "title": "Loom Sessions: Untag Orchestrator",
        "icon": "$(star-empty)"
      },
      {
        "command": "loomSessionTracker.sessionCount",
        "title": "Loom Sessions: Show Simultaneous Session Count",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loomSessionTracker.spawn",
          "when": "view == loomSessions",
          "group": "navigation@1"
        },
        {
          "command": "loomSessionTracker.tagOrchestrator",
          "when": "view == loomSessions",
          "group": "navigation@2"
        },
        {
          "command": "loomSessionTracker.refresh",
          "when": "view == loomSessions",
          "group": "navigation@3"
        },
        {
          "command": "loomSessionTracker.sessionCount",
          "when": "view == loomSessions",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "loomSessionTracker.lock",
          "when": "view == loomSessions && viewItem == loomAgent",
          "group": "inline@1"
        },
        {
          "command": "loomSessionTracker.retire",
          "when": "view == loomSessions && viewItem == loomAgent",
          "group": "inline@2"
        },
        {
          "command": "loomSessionTracker.unlock",
          "when": "view == loomSessions && viewItem == loomAgentLocked",
          "group": "inline@1"
        },
        {
          "command": "loomSessionTracker.lock",
          "when": "view == loomSessions && viewItem == loomAgent",
          "group": "1_actions"
        },
        {
          "command": "loomSessionTracker.unlock",
          "when": "view == loomSessions && viewItem == loomAgentLocked",
          "group": "1_actions"
        },
        {
          "command": "loomSessionTracker.retire",
          "when": "view == loomSessions && viewItem == loomAgent",
          "group": "1_actions"
        },
        {
          "command": "loomSessionTracker.tagOrchestrator",
          "when": "view == loomSessions && viewItem =~ /loomAgent/",
          "group": "1_actions"
        },
        {
          "command": "loomSessionTracker.untagOrchestrator",
          "when": "view == loomSessions && viewItem == loomOrchestrator",
          "group": "inline@1"
        },
        {
          "command": "loomSessionTracker.untagOrchestrator",
          "when": "view == loomSessions && viewItem == loomOrchestrator",
          "group": "1_actions"
        },
        {
          "command": "loomSessionTracker.delete",
          "when": "view == loomSessions && viewItem == loomAgent",
          "group": "2_destructive"
        },
        {
          "command": "loomSessionTracker.tagOrchestrator",
          "when": "view == loomSessions && viewItem == loomOwnerCandidate",
          "group": "inline@1"
        },
        {
          "command": "loomSessionTracker.tagOrchestrator",
          "when": "view == loomSessions && viewItem == loomOwnerCandidate",
          "group": "1_actions"
        }
      ]
    },
    "configuration": {
      "title": "Loom Session Tracker",
      "properties": {
        "loomSessionTracker.intervalMs": {
          "type": "number",
          "default": 15000,
          "minimum": 5000,
          "description": "How often (ms) to refresh the session-agent map. Clamped to a 5s floor."
        },
        "loomSessionTracker.notifyOrchestrator": {
          "type": "boolean",
          "default": true,
          "description": "When a worker's status.json goes working \u2192 idle/blocked, inject a 'check the outbox' prompt into the tagged orchestrator session."
        },
        "loomSessionTracker.sessionWarnThreshold": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Warn (status-bar highlight) when this many Claude conversations are open simultaneously across all windows. Anthropic sets no hard cap, but all sessions share one usage pool; its own guidance suggests 3-5 in parallel."
        },
        "loomSessionTracker.autoResumeAfterLimit": {
          "type": "boolean",
          "default": true,
          "description": "When a session is blocked by a usage limit, automatically nudge it to continue once the limit lifts (detected by the limit banner clearing, not by the UI's coarse ETA)."
        },
        "loomSessionTracker.resumeMessage": {
          "type": "string",
          "default": "",
          "description": "Prompt injected to resume a session after its usage limit resets. Empty = the built-in loom-resume message."
        },
        "loomSessionTracker.enforceWorkerModel": {
          "type": "boolean",
          "default": true,
          "description": "Keep the most expensive model for the orchestrator only. A worker found on a premium model is switched back with /model <workerModel>."
        },
        "loomSessionTracker.workerModel": {
          "type": "string",
          "default": "claude-opus-5",
          "description": "Model id workers are switched to (passed to /model). The orchestrator is exempt."
        },
        "loomSessionTracker.premiumModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Fable 5.1",
            "Fable 5",
            "Mythos 5.1",
            "Mythos 5"
          ],
          "description": "Display names of the top pricing tier ($10/$50 per MTok) reserved for the orchestrator."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "./test.sh"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  }
}